{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": null,
  "outputDirectory": null,
  "headers": [
    {
      "source": "/((?!api/).*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate" }
      ]
    }
  ],
  "env": {
    "PYTHONPATH": "src"
  },
  "functions": {
    "vercel_app.py": {
      "maxDuration": 120
    }
  }
}
